function _gatekeeper_shell() {
  local context="$1" pods pod
  if [[ -z "$context" || "$context" == *$'\n'* ]]; then
    print -u2 "Expected exactly one matching Kubernetes context."
    return 1
  fi
  pods=$(kubectl --context "$context" get pods -l app=gatekeeper -o name) || return
  pod=$(print -r -- "$pods" | grep -v deploy | head -1)
  [[ -n "$pod" ]] || return 1
  echo "Using context: $context"
  echo "Connecting to pod: $pod"
  kubectl --context "$context" exec -it "$pod" -- /bin/sh
}

function quirely() {
  _gatekeeper_shell "$(kubectl config get-contexts -o name | grep gatekeeper | grep quirely)"
}

function flinklyus() {
  _gatekeeper_shell "$(kubectl config get-contexts -o name | grep gatekeeper | grep flinkly | grep us)"
}

