#!/usr/bin/env bash

set -euo pipefail

[[ "$(uname -s)" == "Darwin" ]] || exit 0

# mise bootstrap does not support host-scoped defaults.
if [[ "$(defaults -currentHost read -g AppleFontSmoothing 2>/dev/null || true)" != "0" ]]; then
  defaults -currentHost write -g AppleFontSmoothing -int 0
fi
defaults -currentHost write -g com.apple.mouse.tapBehavior -int 0

# mise bootstrap defaults support scalar values, not arrays.
defaults write NSGlobalDomain AppleLanguages -array "en" "pt-BR"

# NVRAM is outside the macOS defaults system managed by mise.
sudo nvram StartupMute=%01
